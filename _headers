# Cloudflare Pages: заголовки ответа
# дашборд и калькулятор меняются часто — браузер всегда проверяет свежую версию
/stats/*
  Cache-Control: no-cache

# шрифты не меняются — браузер может хранить их год
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# плашка и страницы живых демо — всегда свежие
/assets/demo/*
  Cache-Control: no-cache
/demo/*
  Cache-Control: no-cache
  X-Robots-Tag: noindex
/en/demo/*
  Cache-Control: no-cache
  X-Robots-Tag: noindex
